{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sapoepsilon/pragmatic-skills/blob/main/schema/skill.schema.json",
  "title": "pragmatic-skills manifest",
  "description": "Manifest format for a skill in the pragmatic-skills registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "version", "license", "authors", "compatibility"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$",
      "description": "Lowercase kebab-case identifier, 3-40 chars, unique in the registry."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "One-line summary. Used by agents to decide when to invoke the skill."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$",
      "description": "Semantic version."
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier (e.g. MIT, Apache-2.0)."
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["github"],
        "properties": {
          "github": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,30}$"
      },
      "uniqueItems": true,
      "maxItems": 10
    },
    "trigger_keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 20
    },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["claude_code"] },
        { "required": ["codex"] }
      ],
      "properties": {
        "claude_code": { "$ref": "#/$defs/agentSupport" },
        "codex":       { "$ref": "#/$defs/agentSupport" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network":          { "type": "boolean" },
        "filesystem_write": { "type": "boolean" },
        "shell":            { "type": "boolean" },
        "notes":            { "type": "string" }
      }
    }
  },
  "$defs": {
    "agentSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported"],
      "properties": {
        "supported": { "type": "boolean" },
        "entry":     { "type": "string", "description": "Path relative to the skill directory." },
        "install_to": {
          "type": "string",
          "description": "Default install location. May use {name} placeholder."
        }
      },
      "if":   { "properties": { "supported": { "const": true } } },
      "then": { "required": ["entry"] }
    }
  }
}
