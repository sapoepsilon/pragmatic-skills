{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sapoepsilon/pragmatic-skills/blob/main/schema/marketplace.schema.json",
  "title": "Claude Code marketplace.json (pragmatic-skills subset)",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "owner", "plugins"],
  "properties": {
    "$schema":     { "type": "string" },
    "name":        { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$" },
    "description": { "type": "string", "maxLength": 500 },
    "version":     { "type": "string" },
    "owner": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name":  { "type": "string" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "pluginRoot": { "type": "string" }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "additionalProperties": true,
        "properties": {
          "name":        { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$" },
          "description": { "type": "string", "maxLength": 500 },
          "version":     { "type": "string" },
          "license":     { "type": "string" },
          "category":    { "type": "string" },
          "tags":        { "type": "array", "items": { "type": "string" } },
          "author": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name":  { "type": "string" },
              "email": { "type": "string", "format": "email" }
            }
          },
          "source": {
            "oneOf": [
              { "type": "string", "pattern": "^\\.\\/" },
              {
                "type": "object",
                "required": ["source"],
                "properties": {
                  "source":  { "enum": ["github", "url", "git-subdir", "npm"] },
                  "repo":    { "type": "string" },
                  "url":     { "type": "string" },
                  "path":    { "type": "string" },
                  "ref":     { "type": "string" },
                  "sha":     { "type": "string" },
                  "package": { "type": "string" },
                  "registry":{ "type": "string" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
