# Copy to a gitignored path on the bridge host (e.g. /etc/mobile-autoship-bridge.env) and fill in.
# NEVER commit the real file — it holds the bot token.
TELEGRAM_BOT_TOKEN=123456:ABC-yourBotTokenFromBotFather
ALLOWED_CHAT_ID=000000000
REPO_PATH=/root/Developer/kentra-health
MODEL=custom:GLM-5.2-[Proxy]-0
DROID_BIN=/root/.local/bin/droid
AUTO_LEVEL=medium
