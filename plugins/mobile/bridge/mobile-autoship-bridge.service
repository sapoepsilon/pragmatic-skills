[Unit]
Description=mobile-autoship channel bridge (Telegram -> droid exec, on subscription)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Holds the bot token + chat id — keep it gitignored, root-only.
EnvironmentFile=/etc/mobile-autoship-bridge.env
ExecStart=/opt/mobile-autoship/mobile-bridge.sh
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
